@page "/ingestion/sensors"
@inject HttpClient Http
@using System.Text.Json
@using SmartX.Web.Services

<PageTitle>Sensors - Smart-X</PageTitle>

<div class="mb-4">
    <h2>Sensors</h2>
    <p class="text-muted">
        Register devices, review how the fleet is deployed and attach files to a
        sensor profile.
    </p>
</div>

@if (_loadFailed)
{
    <div class="alert alert-danger">
        Could not reach the gateway API. Make sure SmartX.Api is running.
    </div>
}

@if (_registerSucceeded)
{
    <div class="alert alert-success">Sensor registered. Drag it into the deployment below.</div>
}

<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <button type="button" class="nav-link @TabClass("fleet")" @onclick='() => ShowTab("fleet")'>Fleet</button>
    </li>
    <li class="nav-item">
        <button type="button" class="nav-link @TabClass("register")" @onclick='() => ShowTab("register")'>Register</button>
    </li>
    <li class="nav-item">
        <button type="button" class="nav-link @TabClass("hierarchy")" @onclick='() => ShowTab("hierarchy")'>Hierarchy</button>
    </li>
    <li class="nav-item">
        <button type="button" class="nav-link @TabClass("files")" @onclick='() => ShowTab("files")'>Files</button>
    </li>
</ul>

@if (_activeTab == "fleet")
{
    @if (_sensors == null && !_loadFailed)
    {
        <LoadingBlock />
    }
    else if (_sensors is { Count: 0 })
    {
        <div class="card mb-4">
            <div class="card-body text-center text-muted py-5">
                No sensors registered yet.
            </div>
        </div>
    }
    else if (_sensors != null)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Mac Address</th>
                        <th>Location</th>
                        <th>Category</th>
                        <th>Registered</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sensor in _sensors)
                    {
                        <tr>
                            <td>@sensor.Location.NodeId</td>
                            <td class="font-monospace">@sensor.MacAddress</td>
                            <td>@DescribeLocation(sensor)</td>
                            <td>@sensor.Category</td>
                            <td>@sensor.RegisteredAt.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else if (_activeTab == "register")
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Register a sensor</h5>

            <EditForm Model="_newSensor" OnValidSubmit="RegisterAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                @if (_registerError != null)
                {
                    <div class="alert alert-danger">@_registerError</div>
                }

                <div class="row g-3">
                    <div class="col-12 col-md-5">
                        <label class="form-label">Mac Address</label>
                        <InputText class="form-control font-monospace" @bind-Value="_newSensor.MacAddress" placeholder="AA:BB:CC:DD:EE:FF" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Name</label>
                        <InputText class="form-control" @bind-Value="_newSensor.Location.NodeId" placeholder="soil probe" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">Category</label>
                        <InputSelect class="form-select" @bind-Value="_newSensor.Category">
                            @foreach (var category in Enum.GetValues<SensorCategory>())
                            {
                                <option value="@category">@category</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary mt-3" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    @(_isSubmitting ? "Registering..." : "Register")
                </button>
            </EditForm>
        </div>
    </div>
}
else if (_activeTab == "hierarchy")
{
    <datalist id="@MacListId">
        @if (_sensors != null)
        {
            @foreach (var sensor in _sensors)
            {
                <option value="@sensor.MacAddress"></option>
            }
        }
    </datalist>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Deployment Hierarchy</h5>
            <p class="text-muted small">
                The deployment the gateway is running. A sensor first appears under the
                zone and room it registered with, and this is what says where it sits
                after that.
            </p>

            @if (_editTree != null)
            {
                @if (UnplacedSensors.Count > 0)
                {
                    <div class="alert alert-secondary">
                        <strong>Waiting to be placed</strong>
                        <p class="small mb-2">
                            Registered with the gateway but not in the deployment yet. Drag one
                            onto a zone below, or click it to drop it at the top level.
                        </p>

                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var sensor in UnplacedSensors)
                            {
                                <button class="btn btn-sm btn-outline-secondary"
                                        draggable="true"
                                        @ondragstart="() => StartDraggingUnplaced(sensor)"
                                        @onclick="() => PlaceSensor(sensor)">
                                    @sensor.Location.NodeId
                                    <span class="font-monospace ms-1 text-muted">@sensor.MacAddress</span>
                                </button>
                            }
                        </div>
                    </div>
                }

                @if (_jsonMode)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="text-muted small">Demo examples, for trying the validator:</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadBrokenExample">
                            Broken tree
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadDeepExample">
                            40 levels deep
                        </button>
                    </div>

                    <textarea class="form-control font-monospace" rows="12" @bind="_editJson"></textarea>

                    <div class="mt-2">
                        <button class="btn btn-sm btn-outline-secondary me-2" @onclick="ApplyJson">Apply JSON</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ShowBuilder">Back to builder</button>
                    </div>

                    @if (_jsonParseError != null)
                    {
                        <div class="alert alert-danger mt-3">@_jsonParseError</div>
                    }
                }
                else
                {
                    <div class="border rounded p-3">
                        <DeploymentTreeEditor Node="_editTree"
                                              MacListId="@MacListId"
                                              DefaultMacAddress="@DefaultMacAddress"
                                              OnChanged="OnEditTreeChanged"
                                              OnDragStart="StartDrag"
                                              OnDropInto="DropIntoZone"
                                              OnDropBefore="DropBefore" />
                    </div>

                    <div class="mt-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ShowJson">Edit as JSON</button>
                    </div>
                }

                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button class="btn btn-outline-primary" @onclick="ValidateEditAsync" disabled="@_isValidating">
                        @if (_isValidating)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        @(_isValidating ? "Validating..." : "Validate")
                    </button>

                    <button class="btn btn-primary" @onclick="SaveDeploymentAsync" disabled="@(!_editValidated || _isSaving)">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        @(_isSaving ? "Saving..." : "Save")
                    </button>

                    <button class="btn btn-outline-secondary" @onclick="CancelEditing">Cancel</button>

                    @if (!_editValidated)
                    {
                        <span class="text-muted small align-self-center">
                            Validate the tree before it can be saved.
                        </span>
                    }
                </div>

                @if (_editResult != null)
                {
                    <div class="mt-3">
                        <span class="badge @(_editResult.IsValid ? "bg-success" : "bg-danger") me-2">
                            @(_editResult.IsValid ? "Valid" : "Rejected")
                        </span>
                        <span class="badge bg-secondary me-2">@_editResult.NodesChecked nodes checked</span>
                        <span class="badge bg-secondary me-2">deepest level @_editResult.DeepestLevel</span>
                        <span class="badge bg-secondary">@_editResult.SensorsFound sensors</span>

                        @if (_editResult.Errors.Count > 0)
                        {
                            <ul class="mt-3">
                                @foreach (var error in _editResult.Errors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        }
                    </div>
                }

                @if (_editError != null)
                {
                    <div class="alert alert-danger mt-3">@_editError</div>
                }

            }
            else if (_deploymentTree != null)
            {
                <DeploymentTreeNode Node="_deploymentTree" />

                <button class="btn btn-primary mt-3" @onclick="StartEditing">Edit deployment</button>
            }
            else if (!_loadFailed)
            {
                <LoadingBlock />
            }
        </div>
    </div>
}
else if (_activeTab == "files")
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Attachments</h5>
            <p class="text-muted small">
                Config files, deployment photos or hardware logs attached to a sensor.
                Stored encrypted on the gateway.
            </p>

            <div class="mb-3">
                <label class="form-label">Sensor</label>
                <select class="form-select" style="max-width: 400px;" value="@_attachmentsMac" @onchange="OnAttachmentsSensorChangedAsync">
                    @if (_sensors != null)
                    {
                        @foreach (var sensor in _sensors)
                        {
                            <option value="@sensor.MacAddress">@sensor.MacAddress (@sensor.Category)</option>
                        }
                    }
                </select>
            </div>

            @if (_attachments == null)
            {
                <LoadingBlock />
            }
            else if (_attachments.Count == 0)
            {
                <div class="text-center text-muted py-4">No files attached to this sensor yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>File</th>
                                <th>Size</th>
                                <th>Uploaded</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var attachment in _attachments)
                            {
                                <tr>
                                    <td>@attachment.FileName</td>
                                    <td>@FormatFileSize(attachment.SizeInBytes)</td>
                                    <td>@attachment.UploadedAt.ToLocalTime().ToString("g")</td>
                                    <td class="text-end">
                                        @if (_pendingDeleteId == attachment.Id)
                                        {
                                            <span class="text-muted small me-2">Delete this file?</span>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDeleteAsync(attachment.Id)">Yes, delete</button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelDelete">Cancel</button>
                                        }
                                        else
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" href="@DownloadUrl(attachment.Id)">Download</a>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RequestDelete(attachment.Id)">Delete</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <hr />

            @if (_uploadSucceeded)
            {
                <div class="alert alert-success">File uploaded.</div>
            }
            @if (_attachmentError != null)
            {
                <div class="alert alert-danger">@_attachmentError</div>
            }

            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-8">
                    <label class="form-label">Attach a file</label>
                    <InputFile class="form-control" OnChange="OnFileSelected" />
                </div>
                <div class="col-12 col-md-4">
                    <button class="btn btn-primary" @onclick="UploadAsync" disabled="@(_isUploading || _selectedFile == null)">
                        @if (_isUploading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        @(_isUploading ? "Uploading..." : "Upload")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string _activeTab = "fleet";

    private List<SensorRegistration>? _sensors;
    private bool _loadFailed;

    private SensorRegistration _newSensor = new();
    private bool _isSubmitting;
    private bool _registerSucceeded;
    private string? _registerError;

    private const string MacListId = "known-mac-addresses";

    private static readonly JsonSerializerOptions TreeDisplayOptions = new(ApiJsonOptions.Default) { WriteIndented = true };

    private DeploymentNode? _deploymentTree;
    private DeploymentNode? _editTree;
    private DeploymentNode? _draggedNode;
    private DeploymentValidationResult? _editResult;
    private string? _editError;
    private bool _editValidated;
    private bool _isSaving;
    private bool _isValidating;
    private bool _jsonMode;
    private string _editJson = string.Empty;
    private string? _jsonParseError;

    private string DefaultMacAddress =>
        _sensors is { Count: > 0 } ? _sensors[0].MacAddress : "AA:BB:CC:DD:EE:FF";

    private const long MaxUploadBytes = 25 * 1024 * 1024;
    private const int AlertTimeoutMilliseconds = 3000;

    private string _attachmentsMac = string.Empty;
    private List<AttachmentSummary>? _attachments;
    private string? _pendingDeleteId;
    private IBrowserFile? _selectedFile;
    private bool _isUploading;
    private bool _uploadSucceeded;
    private string? _attachmentError;

    private void ShowTab(string tab)
    {
        _activeTab = tab;
    }

    private string TabClass(string tab)
    {
        return _activeTab == tab ? "active" : string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadSensorsAsync();
        await LoadDeploymentAsync();

        if (_sensors is { Count: > 0 })
        {
            _attachmentsMac = _sensors[0].MacAddress;
        }

        await LoadAttachmentsAsync();
    }

    private void StartEditing()
    {
        if (_deploymentTree == null)
        {
            return;
        }

        // Editing a copy is what lets Cancel simply throw the whole thing away.
        _editTree = DeploymentTreeOperations.Clone(_deploymentTree);
        _editResult = null;
        _editError = null;
        _editValidated = false;
    }

    private void CancelEditing()
    {
        _editTree = null;
        _editResult = null;
        _editError = null;
        _editValidated = false;
    }

    //the registered sensors the tree being edited does not place anywhere
    private List<SensorRegistration> UnplacedSensors
    {
        get
        {
            if (_editTree == null || _sensors == null)
            {
                return new List<SensorRegistration>();
            }

            var placed = DeploymentTreeOperations.MacAddressesIn(_editTree);

            return _sensors
                .Where(sensor => !placed.Contains(sensor.MacAddress))
                .ToList();
        }
    }

    private void PlaceSensor(SensorRegistration sensor)
    {
        if (_editTree == null)
        {
            return;
        }

        // Clicking drops it at the top level, where it is easy to see and then drag
        // somewhere better. A sensor registered by name has no zone to go back to.
        _editTree.Children.Add(SensorLeafFor(sensor));
        OnEditTreeChanged();
    }

    private void StartDraggingUnplaced(SensorRegistration sensor)
    {
        // The leaf is built here rather than when it lands, so the drop handlers do
        // not have to care whether what they were given is already in the tree.
        _draggedNode = SensorLeafFor(sensor);
    }

    //describes where a sensor sits, or says so when it is not in the tree yet
    private static string DescribeLocation(SensorRegistration sensor)
    {
        if (string.IsNullOrWhiteSpace(sensor.Location.Zone))
        {
            return "Not placed";
        }

        if (string.Equals(sensor.Location.Zone, sensor.Location.Room, StringComparison.OrdinalIgnoreCase))
        {
            return sensor.Location.Zone;
        }

        return $"{sensor.Location.Zone} / {sensor.Location.Room}";
    }

    private static DeploymentNode SensorLeafFor(SensorRegistration sensor)
    {
        return new DeploymentNode
        {
            Name = sensor.Location.NodeId,
            SensorMacAddress = sensor.MacAddress
        };
    }

    private void OnEditTreeChanged()
    {
        // A pass describes the tree as it was when it was checked, so changing
        // anything afterwards has to put Save back out of reach.
        _editResult = null;
        _editValidated = false;
    }

    private async Task ValidateEditAsync()
    {
        if (_editTree == null)
        {
            return;
        }

        _editResult = null;
        _editError = null;
        _editValidated = false;
        _isValidating = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/deployment/validate", _editTree, ApiJsonOptions.Default);

            if (response.IsSuccessStatusCode)
            {
                _editResult = await response.Content.ReadFromJsonAsync<DeploymentValidationResult>(ApiJsonOptions.Default);
                _editValidated = _editResult is { IsValid: true };
            }
            else
            {
                _editError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (HttpRequestException)
        {
            _editError = "Could not reach the gateway API.";
        }
        finally
        {
            _isValidating = false;
        }
    }

    private async Task SaveDeploymentAsync()
    {
        if (_editTree == null || !_editValidated)
        {
            return;
        }

        _editError = null;
        _isSaving = true;

        try
        {
            var response = await Http.PutAsJsonAsync("api/deployment", _editTree, ApiJsonOptions.Default);

            if (response.IsSuccessStatusCode)
            {
                _editTree = null;
                _editResult = null;
                _editValidated = false;

                await LoadDeploymentAsync();
            }
            else
            {
                // The gateway checks the tree again before it keeps anything, so a
                // refusal comes back as the same result shape the validate button
                // already knows how to show.
                _editResult = await response.Content.ReadFromJsonAsync<DeploymentValidationResult>(ApiJsonOptions.Default);
                _editValidated = false;

                if (_editResult == null)
                {
                    _editError = "The gateway would not accept that deployment.";
                }
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            _editError = "Could not reach the gateway API.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void StartDrag(DeploymentNode node)
    {
        _draggedNode = node;
    }

    private void DropIntoZone(DeploymentNode zone)
    {
        if (_editTree == null || _draggedNode == null)
        {
            return;
        }

        if (DeploymentTreeOperations.MoveInto(_editTree, _draggedNode, zone))
        {
            OnEditTreeChanged();
        }

        _draggedNode = null;
    }

    private void DropBefore(DeploymentDrop drop)
    {
        if (_editTree == null || _draggedNode == null)
        {
            return;
        }

        if (DeploymentTreeOperations.MoveBefore(_editTree, _draggedNode, drop.Zone, drop.Before))
        {
            OnEditTreeChanged();
        }

        _draggedNode = null;
    }

    private async Task LoadDeploymentAsync()
    {
        try
        {
            _deploymentTree = await Http.GetFromJsonAsync<DeploymentNode>("api/deployment", ApiJsonOptions.Default);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            _loadFailed = true;
        }
    }

    private async Task LoadSensorsAsync()
    {
        try
        {
            _sensors = await Http.GetFromJsonAsync<List<SensorRegistration>>("api/sensors", ApiJsonOptions.Default);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            _loadFailed = true;
        }
    }

    private async Task RegisterAsync()
    {
        _isSubmitting = true;
        _registerSucceeded = false;
        _registerError = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/sensors", _newSensor, ApiJsonOptions.Default);

            if (response.IsSuccessStatusCode)
            {
                _registerSucceeded = true;
                _newSensor = new SensorRegistration();

                await LoadSensorsAsync();
                await LoadDeploymentAsync();

                // A sensor registered by name is not in the deployment yet, so the
                // next thing to do is put it somewhere. This opens the tab already in
                // edit mode, with the new sensor waiting at the top.
                _activeTab = "hierarchy";
                StartEditing();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _registerError = await response.Content.ReadAsStringAsync();
            }
            else
            {
                _registerError = "The gateway rejected that registration.";
            }
        }
        catch (HttpRequestException)
        {
            _registerError = "Could not reach the gateway API.";
        }
        finally
        {
            _isSubmitting = false;
        }

        await ClearRegisterSuccessAsync();
    }

    private async Task ClearRegisterSuccessAsync()
    {
        if (!_registerSucceeded)
        {
            return;
        }

        // Without this render the flag would be set and cleared inside one pass,
        // so the alert would never actually appear.
        StateHasChanged();
        await Task.Delay(AlertTimeoutMilliseconds);
        _registerSucceeded = false;
    }

    private void LoadBrokenExample()
    {
        _editJson = JsonSerializer.Serialize(DeploymentTreeBuilder.BuildBrokenExample(), TreeDisplayOptions);
        _jsonParseError = null;
    }

    private void LoadDeepExample()
    {
        _editJson = JsonSerializer.Serialize(DeploymentTreeBuilder.BuildDeepExample(), TreeDisplayOptions);
        _jsonParseError = null;
    }

    private void ShowJson()
    {
        if (_editTree == null)
        {
            return;
        }

        _editJson = JsonSerializer.Serialize(_editTree, TreeDisplayOptions);
        _jsonParseError = null;
        _jsonMode = true;
    }

    private void ShowBuilder()
    {
        // Anything typed since the last Apply is dropped on purpose, so there is
        // never a question of which of the two is the tree being edited.
        _jsonParseError = null;
        _jsonMode = false;
    }

    private void ApplyJson()
    {
        DeploymentNode? tree;

        try
        {
            tree = JsonSerializer.Deserialize<DeploymentNode>(_editJson, ApiJsonOptions.Default);
        }
        catch (JsonException problem)
        {
            _jsonParseError = $"That is not valid JSON. {problem.Message}";
            return;
        }

        if (tree == null)
        {
            _jsonParseError = "That is not valid JSON.";
            return;
        }

        _editTree = tree;
        _jsonParseError = null;
        _jsonMode = false;

        // Pasted json is a change like any other, so it has to be validated before
        // it can be saved.
        OnEditTreeChanged();
    }

    private async Task OnAttachmentsSensorChangedAsync(ChangeEventArgs e)
    {
        _attachmentsMac = e.Value?.ToString() ?? string.Empty;
        await LoadAttachmentsAsync();
    }

    private async Task LoadAttachmentsAsync()
    {
        // A confirm left open against the old list would point at a file that is
        // no longer on screen.
        _pendingDeleteId = null;

        if (string.IsNullOrEmpty(_attachmentsMac))
        {
            _attachments = new List<AttachmentSummary>();
            return;
        }

        try
        {
            _attachments = await Http.GetFromJsonAsync<List<AttachmentSummary>>($"api/sensors/{_attachmentsMac}/attachments", ApiJsonOptions.Default);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            _attachments = new List<AttachmentSummary>();
        }
    }

    private string DownloadUrl(string attachmentId)
    {
        return $"{Http.BaseAddress}api/sensors/{_attachmentsMac}/attachments/{attachmentId}";
    }

    private void RequestDelete(string attachmentId)
    {
        _pendingDeleteId = attachmentId;
    }

    private void CancelDelete()
    {
        _pendingDeleteId = null;
    }

    private async Task ConfirmDeleteAsync(string attachmentId)
    {
        _pendingDeleteId = null;
        _attachmentError = null;

        try
        {
            var response = await Http.DeleteAsync($"api/sensors/{_attachmentsMac}/attachments/{attachmentId}");

            // Without this the file simply stayed in the list and nothing said why.
            if (!response.IsSuccessStatusCode)
            {
                _attachmentError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (HttpRequestException)
        {
            _attachmentError = "Could not reach the gateway API.";
        }

        await LoadAttachmentsAsync();
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024.0:0.#} KB";
        }

        return $"{bytes / (1024.0 * 1024.0):0.#} MB";
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _uploadSucceeded = false;
        _attachmentError = null;
    }

    private async Task UploadAsync()
    {
        if (_selectedFile == null)
        {
            return;
        }

        _isUploading = true;
        _uploadSucceeded = false;
        _attachmentError = null;

        try
        {
            using var content = new MultipartFormDataContent();
            using var fileStream = _selectedFile.OpenReadStream(MaxUploadBytes);
            using var streamContent = new StreamContent(fileStream);
            content.Add(streamContent, "file", _selectedFile.Name);

            var response = await Http.PostAsync($"api/sensors/{_attachmentsMac}/attachments", content);

            if (response.IsSuccessStatusCode)
            {
                _uploadSucceeded = true;
                _selectedFile = null;
                await LoadAttachmentsAsync();
            }
            else
            {
                _attachmentError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (HttpRequestException)
        {
            _attachmentError = "Could not reach the gateway API.";
        }
        finally
        {
            _isUploading = false;
        }

        await ClearUploadSuccessAsync();
    }

    private async Task ClearUploadSuccessAsync()
    {
        if (!_uploadSucceeded)
        {
            return;
        }

        StateHasChanged();
        await Task.Delay(AlertTimeoutMilliseconds);
        _uploadSucceeded = false;
    }
}
