@page "/"

<PageTitle>Smart-X Gateway</PageTitle>

<div class="mb-4">
    <h1>Smart-X</h1>
    <p class="text-muted">
        A hybrid IoT telemetry gateway for monitoring distributed environments.
        Pick a pillar to get started.
    </p>
</div>

<div class="row g-3">
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <span class="badge bg-success align-self-start mb-2">Active</span>
                <h5 class="card-title">Sensor Data Ingestion and Telemetry</h5>
                <p class="card-text flex-grow-1">
                    Register sensors, ingest their telemetry and attach device
                    files to a profile.
                </p>
                <a class="btn btn-primary" href="ingestion/sensors">Open</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <span class="badge bg-secondary align-self-start mb-2">Part 2</span>
                <h5 class="card-title">Real-Time Command Stream and History</h5>
                <p class="card-text flex-grow-1">
                    Live device commands, override history and predictive
                    action suggestions.
                </p>
                <button class="btn btn-primary" disabled>Open</button>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <span class="badge bg-secondary align-self-start mb-2">Part 3</span>
                <h5 class="card-title">Network Topology and Mesh Routing</h5>
                <p class="card-text flex-grow-1">
                    Mesh network view with routing and connectivity analysis
                    across the fleet.
                </p>
                <button class="btn btn-primary" disabled>Open</button>
            </div>
        </div>
    </div>
</div>
