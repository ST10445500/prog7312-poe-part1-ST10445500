@page "/ingestion/sensors"
@inject HttpClient Http
@using System.Text.Json
@using SmartX.Web.Services

<PageTitle>Sensors - Smart-X</PageTitle>

<h2>Sensors</h2>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Register a sensor</h5>

        <EditForm Model="_newSensor" OnValidSubmit="RegisterAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            @if (_registerSucceeded)
            {
                <div class="alert alert-success">Sensor registered.</div>
            }
            @if (_registerError != null)
            {
                <div class="alert alert-danger">@_registerError</div>
            }

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label">Mac Address</label>
                    <InputText class="form-control" @bind-Value="_newSensor.MacAddress" placeholder="AA:BB:CC:DD:EE:FF" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label">Zone</label>
                    <InputText class="form-control" @bind-Value="_newSensor.Location.Zone" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label">Room</label>
                    <InputText class="form-control" @bind-Value="_newSensor.Location.Room" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label">Node Id</label>
                    <InputText class="form-control" @bind-Value="_newSensor.Location.NodeId" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label">Category</label>
                    <InputSelect class="form-select" @bind-Value="_newSensor.Category">
                        @foreach (var category in Enum.GetValues<SensorCategory>())
                        {
                            <option value="@category">@category</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <button type="submit" class="btn btn-primary mt-3" disabled="@_isSubmitting">
                @(_isSubmitting ? "Registering..." : "Register")
            </button>
        </EditForm>
    </div>
</div>

@if (_loadFailed)
{
    <div class="alert alert-danger">
        Could not reach the gateway API. Make sure SmartX.Api is running.
    </div>
}
else if (_sensors == null)
{
    <p class="text-muted">Loading...</p>
}
else if (_sensors.Count == 0)
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            No sensors registered yet.
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Mac Address</th>
                    <th>Zone</th>
                    <th>Room</th>
                    <th>Node</th>
                    <th>Category</th>
                    <th>Registered</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sensor in _sensors)
                {
                    <tr>
                        <td>@sensor.MacAddress</td>
                        <td>@sensor.Location.Zone</td>
                        <td>@sensor.Location.Room</td>
                        <td>@sensor.Location.NodeId</td>
                        <td>@sensor.Category</td>
                        <td>@sensor.RegisteredAt.ToLocalTime().ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Deployment Hierarchy</h5>
            <p class="text-muted small">
                Built from the registered fleet, grouped by zone then room.
            </p>
            <DeploymentTreeNode Node="DeploymentTreeBuilder.BuildFromSensors(_sensors)" />
        </div>
    </div>
}

<div class="card mt-4">
    <div class="card-body">
        <h5 class="card-title">Custom Deployment Check</h5>
        <p class="text-muted small">
            The gateway accepts a deployment tree of any depth over the API. Edit the
            JSON and validate it to see what the recursive walk reports — this is
            exactly what gets posted to <code>/api/deployment/validate</code>.
        </p>

        <div class="mb-3">
            <button class="btn btn-sm btn-outline-secondary me-2" @onclick="LoadActiveHierarchy">
                Load the active hierarchy
            </button>
            <button class="btn btn-sm btn-outline-secondary me-2" @onclick="LoadBrokenExample">
                Load a broken example
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="LoadDeepExample">
                Nest 40 levels
            </button>
        </div>

        <textarea class="form-control font-monospace" rows="12" @bind="_customTreeJson"></textarea>

        <button class="btn btn-primary mt-3" @onclick="ValidateCustomTreeAsync" disabled="@_isValidating">
            @(_isValidating ? "Validating..." : "Validate hierarchy")
        </button>

        @if (_customTreeParseError != null)
        {
            <div class="alert alert-danger mt-3">@_customTreeParseError</div>
        }

        @if (_customTreeResult != null)
        {
            <div class="mt-3">
                <span class="badge @(_customTreeResult.IsValid ? "bg-success" : "bg-danger") me-2">
                    @(_customTreeResult.IsValid ? "Valid" : "Rejected")
                </span>
                <span class="badge bg-secondary me-2">@_customTreeResult.NodesChecked nodes checked</span>
                <span class="badge bg-secondary me-2">deepest level @_customTreeResult.DeepestLevel</span>
                <span class="badge bg-secondary">@_customTreeResult.SensorsFound sensors</span>

                @if (_customTreeResult.Errors.Count > 0)
                {
                    <ul class="mt-3">
                        @foreach (var error in _customTreeResult.Errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<SensorRegistration>? _sensors;
    private bool _loadFailed;

    private SensorRegistration _newSensor = new();
    private bool _isSubmitting;
    private bool _registerSucceeded;
    private string? _registerError;

    private static readonly JsonSerializerOptions TreeDisplayOptions = new(ApiJsonOptions.Default) { WriteIndented = true };

    private string _customTreeJson = JsonSerializer.Serialize(DeploymentTreeBuilder.BuildBrokenExample(), TreeDisplayOptions);
    private DeploymentValidationResult? _customTreeResult;
    private string? _customTreeParseError;
    private bool _isValidating;

    protected override async Task OnInitializedAsync()
    {
        await LoadSensorsAsync();
    }

    private async Task LoadSensorsAsync()
    {
        try
        {
            _sensors = await Http.GetFromJsonAsync<List<SensorRegistration>>("api/sensors", ApiJsonOptions.Default);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            _loadFailed = true;
        }
    }

    private async Task RegisterAsync()
    {
        _isSubmitting = true;
        _registerSucceeded = false;
        _registerError = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/sensors", _newSensor, ApiJsonOptions.Default);

            if (response.IsSuccessStatusCode)
            {
                _registerSucceeded = true;
                _newSensor = new SensorRegistration();
                await LoadSensorsAsync();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _registerError = await response.Content.ReadAsStringAsync();
            }
            else
            {
                _registerError = "The gateway rejected that registration.";
            }
        }
        catch (HttpRequestException)
        {
            _registerError = "Could not reach the gateway API.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void LoadActiveHierarchy()
    {
        var fleet = _sensors ?? new List<SensorRegistration>();
        LoadCustomTree(DeploymentTreeBuilder.BuildFromSensors(fleet));
    }

    private void LoadBrokenExample()
    {
        LoadCustomTree(DeploymentTreeBuilder.BuildBrokenExample());
    }

    private void LoadDeepExample()
    {
        LoadCustomTree(DeploymentTreeBuilder.BuildDeepExample());
    }

    private void LoadCustomTree(DeploymentNode tree)
    {
        _customTreeJson = JsonSerializer.Serialize(tree, TreeDisplayOptions);
        _customTreeResult = null;
        _customTreeParseError = null;
    }

    private async Task ValidateCustomTreeAsync()
    {
        _customTreeResult = null;
        _customTreeParseError = null;

        DeploymentNode? tree;

        try
        {
            tree = JsonSerializer.Deserialize<DeploymentNode>(_customTreeJson, ApiJsonOptions.Default);
        }
        catch (JsonException problem)
        {
            _customTreeParseError = $"That is not valid JSON. {problem.Message}";
            return;
        }

        if (tree == null)
        {
            _customTreeParseError = "That is not valid JSON.";
            return;
        }

        _isValidating = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/deployment/validate", tree, ApiJsonOptions.Default);

            if (response.IsSuccessStatusCode)
            {
                _customTreeResult = await response.Content.ReadFromJsonAsync<DeploymentValidationResult>(ApiJsonOptions.Default);
            }
            else
            {
                _customTreeParseError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (HttpRequestException)
        {
            _customTreeParseError = "Could not reach the gateway API.";
        }
        finally
        {
            _isValidating = false;
        }
    }
}
